PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/travel-ai

# Needed from M1 onwards
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
