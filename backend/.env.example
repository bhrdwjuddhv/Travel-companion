# OPENAI_EMBEDDING_MODEL=
# OPENAI_GUARDRAIL_MODEL=

# Optional: analytics + LLM observability. No key = no telemetry, app unchanged.
# Project token from PostHog -> Settings -> Project. Use the EU host if your
# project is in the EU region.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
